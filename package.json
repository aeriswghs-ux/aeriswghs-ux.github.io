    "axe-core": "^4.14.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
